{
  "manifest_version": 3,
  "name": "Echo Protocol Activity Monitor",
  "version": "1.0.0",
  "description": "Reports browser activity to Echo Protocol dead man's switch",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Echo Protocol"
  }
}
