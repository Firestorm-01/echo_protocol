# Echo Protocol Configuration
# Copy this to .env and fill in your values

# Database (defaults to SQLite)
DATABASE_URL=sqlite:///data/echo.db

# Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# M-of-N consensus: fire if M triggers fail out of N active
CONSENSUS_M=3

# Check interval in seconds (default: 5 minutes)
CHECK_INTERVAL=300

# Grace period multiplier before firing
GRACE_PERIOD_MULTIPLIER=1.5

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Twilio SMS (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# API
API_HOST=0.0.0.0
API_PORT=5000
API_SECRET_KEY=changeme-use-a-long-random-string
